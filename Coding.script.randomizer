local isDragging = false
SliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isDragging = true end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local deltaX = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
        SliderKnob.Position = UDim2.new(deltaX, -7, -1.1, 0)
        Settings.FOV = math.floor(40 + (deltaX * 460))
        FOVDisplayLabel.Text = "Field of View: " .. Settings.FOV
        FOVCircle.Radius = Settings.FOV
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isDragging = false end
end)

local function PassWallCheck(targetPart, enemyCharacter)
    if not Settings.WallCheck then return true end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, enemyCharacter}
    raycastParams.IgnoreWater = true
    return Workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, raycastParams) == nil
end

local function CharacterIsWieldingSniper()
    if not LocalPlayer.Character then return false end
    local activeTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if activeTool then
        local toolName = activeTool.Name:lower()
        return toolName:find("sniper") or toolName:find("awp") or toolName:find("rifle") or toolName:find("bolt") or toolName:find("scope") or toolName:find("scout")
    end
    return false
end

local function TargetIsCloaked(character)
    if not character then return false end
    local equippedTool = character:FindFirstChildOfClass("Tool")
    if equippedTool then
        local name = equippedTool.Name:lower()
        if name:find("cloak") or name:find("invisible") or name:find("hide") or name:find("vanish") then
            return true
        end
    end
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if part.Transparency > 0.65 then
                return true
            end
        end
    end
    return false
end

task.spawn(function()
    while task.wait(0.03) do 
        if not Settings.AimbotEnabled or not LocalPlayer.Character then 
            _G.GlobalTargetPart = nil
            continue 
        end
        
        local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not localRoot then _G.GlobalTargetPart = nil continue end

        local potentialTarget = nil
        local optimalTargetScore = math.huge
        local isHoldingSniper = CharacterIsWieldingSniper()
        
        local activeAttacker = _G.LastAttacker
        local attackerValid = (activeAttacker and activeAttacker.Character and (os.clock() - (_G.LastAttackerTime or 0) < 4.0))

        local allPlayers = Players:GetPlayers()
        for i = 1, #allPlayers do
            local player = allPlayers[i]
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                if Settings.KillCheck and (not humanoid or humanoid.Health <= 0) then continue end
                if Settings.TeamCheck and player.Team == LocalPlayer.Team then continue end
                if Settings.IgnoreShields and character:FindFirstChildOfClass("ForceField") then continue end
                if TargetIsCloaked(character) then continue end

                local targetBone = character:FindFirstChild(Settings.TargetPart) or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChildWhichIsA("BasePart")
                local rootPart = character:FindFirstChild("HumanoidRootPart") or targetBone
                if not targetBone or not rootPart then continue end

                local physicalDistance = (rootPart.Position - localRoot.Position).Magnitude
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetBone.Position)
                local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local fovDistance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude

                local isCQCZone = (physicalDistance <= Settings.CQCDistance)
                local isMidZone = (physicalDistance > Settings.CQCDistance and physicalDistance <= Settings.MidDistance)
                local isSniperZone = (physicalDistance > Settings.MidDistance and physicalDistance <= Settings.MaxSniperDistance)

                local targetValid = false
                local targetScoreWeight = physicalDistance

                if attackerValid and player == activeAttacker then
                    targetValid = true
                    targetScoreWeight = physicalDistance * 0.01 
                elseif isCQCZone then
                    targetValid = true
                    targetScoreWeight = physicalDistance * 0.1 
                elseif isMidZone and onScreen and (fovDistance <= Settings.FOV) then
                    targetValid = true
                    targetScoreWeight = physicalDistance * 1.0
                elseif isSniperZone and isHoldingSniper and onScreen and (fovDistance <= Settings.FOV) then
                    targetValid = true
                    targetScoreWeight = physicalDistance * 2.0
                end

                if targetValid and targetScoreWeight < optimalTargetScore and PassWallCheck(targetBone, character) then
                    optimalTargetScore = targetScoreWeight
                    potentialTarget = targetBone
                end
            end
        end
        _G.GlobalTargetPart = potentialTarget
    end
end)

RunService:BindToRenderStep("FluidCameraStabilizer", Enum.RenderPriority.Camera.Value + 1, function()
    CalibrateFOVCenter()
    Camera.CameraType = Enum.CameraType.Custom 
    
    if Settings.AimbotEnabled and _G.GlobalTargetPart and _G.GlobalTargetPart.Parent then
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or #UserInputService:GetFocusedTextBox() == 0 then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, _G.GlobalTargetPart.Position)
        end
    end
end)
                                    
